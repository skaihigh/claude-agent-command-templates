{
  "name": "firebase-app",
  "displayName": "Firebase Full-Stack App",
  "description": "Full-stack application with React frontend and Firebase backend (Auth, Firestore, Storage, Functions). Multi-tenant ready.",
  "version": "1.0.0",
  "author": "Christian Mesloes Kaiaa",
  "created": "2025-11-17",
  "tags": ["react", "typescript", "firebase", "firestore", "auth", "full-stack"],

  "tech_stack": {
    "frontend": ["React 18", "TypeScript", "Vite", "TailwindCSS"],
    "backend": ["Firebase Auth", "Firestore", "Firebase Storage", "Cloud Functions"],
    "testing": ["Vitest", "Testing Library", "Firebase Emulator Suite"],
    "tooling": ["ESLint", "Prettier", "TypeScript"]
  },

  "required_mcps": [
    {
      "name": "firebase",
      "description": "Firebase tools for deployment and management",
      "required": true
    }
  ],

  "optional_mcps": [
    {
      "name": "tavily-mcp",
      "description": "Web search for documentation lookup",
      "env_vars": ["TAVILY_API_KEY"]
    },
    {
      "name": "@allpepper/memory-bank-mcp",
      "description": "Project memory and context management",
      "env_vars": ["MEMORY_BANK_ROOT"]
    }
  ],

  "specialized_agents": [
    {
      "name": "react-architect",
      "description": "React + TypeScript component design, state management, and performance optimization"
    },
    {
      "name": "test-engineer",
      "description": "Unit, integration, E2E tests"
    },
    {
      "name": "codebase-analyzer",
      "description": "Analyzes codebase implementation details"
    }
  ],

  "slash_commands": [
    "/implement_plan",
    "/test-coverage",
    "/create_plan",
    "/validate_plan",
    "/new-component",
    "/research_codebase"
  ],

  "skills": [],

  "project_structure": {
    "src/features": "Feature-based architecture",
    "src/components": "Shared React components",
    "src/services": "Firebase service integrations",
    "src/hooks": "Custom React hooks",
    "functions/": "Cloud Functions (Node.js)",
    "firestore.rules": "Firestore security rules",
    "storage.rules": "Storage security rules"
  },

  "setup_instructions": [
    "1. Copy .claude/ directory to your new Firebase app project",
    "2. Ensure global MCP secrets are configured (~/.config/claude-mcp/mcp-secrets.env)",
    "3. Install Firebase CLI: npm install -g firebase-tools",
    "4. Run: firebase login",
    "5. Create Firebase project in Firebase Console",
    "6. Initialize Firebase: firebase init (select Auth, Firestore, Storage, Functions, Hosting)",
    "7. Configure .env.local with Firebase credentials",
    "8. Install dependencies: pnpm install",
    "9. Start emulators: firebase emulators:start",
    "10. Start dev server: pnpm dev"
  ],

  "gitignore_additions": [
    "# Firebase Admin SDK (NEVER commit these!)",
    "*firebase-adminsdk*.json",
    "serviceAccountKey.json",
    "",
    "# Firebase cache",
    ".firebase/",
    "firebase-debug.log",
    "firestore-debug.log",
    "ui-debug.log",
    "*.cache",
    "",
    "# Environment variables with secrets",
    ".env.local",
    ".env.*.local",
    "",
    "# Functions",
    "functions/node_modules/",
    "functions/lib/"
  ],

  "notes": [
    "Multi-tenant architecture ready",
    "Includes Firebase security rules templates",
    "Firebase Emulator Suite for local development",
    "Cloud Functions for server-side logic",
    "Authentication with multiple providers support"
  ]
}
